{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["@angular-eslint/schematics"],
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "changeDetection": "OnPush",
      "viewEncapsulation": "None",
      "skipTests": true,
      "standalone": true,
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "newProjectRoot": "packages/ng",
  "projects": {
    "ng": {
      "root": "./packages/ng/",
      "projectType": "library",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "packages/ng/tsconfig.lib.prod.json",
            "outputPath": "dist/ng",
            "assets": [
              {
                "glob": "**/*.scss",
                "input": "packages/ng/styles",
                "output": "src"
              },
              {
                "glob": "material/style/**/*.scss",
                "input": "packages/ng"
              },
              {
                "glob": "formly/src/**/*.scss",
                "input": "packages/ng"
              },
              {
                "glob": "formly/style/**/*.scss",
                "input": "packages/ng"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["packages/ng/styles"]
            },
            "deleteOutputPath": true
          },
          "configurations": {
            "development": {}
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["packages/ng/**/*.ts", "stories/**/*.ts", "packages/ng/**/*.html", "stories/**/*.html"]
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": ".storybook",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", ".storybook"],
            "port": 6006,
            "styles": [".storybook/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["packages/ng/styles", "node_modules"]
            }
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": ".storybook",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", ".storybook"],
            "outputDir": "storybook-static",
            "styles": [".storybook/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["packages/ng/styles", "node_modules"]
            }
          }
        }
      },
      "sourceRoot": "./packages/ng/"
    },
    "prisme": {
      "root": "./packages/prisme/",
      "projectType": "library",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "packages/prisme/tsconfig.lib.prod.json",
            "outputPath": "dist/prisme"
          },
          "configurations": {
            "development": {}
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["packages/prisme/**/*.ts", "packages/prisme/**/*.html"]
          }
        }
      },
      "sourceRoot": "./packages/prisme/"
    },
    "web-components": {
      "root": "./packages/web-components/",
      "sourceRoot": "./packages/web-components/src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web-components",
            "browser": "packages/web-components/src/main.ts",
            "tsConfig": "packages/web-components/tsconfig.app.json",
            "index": false,
            "polyfills": [],
            "outputHashing": "none",
            "sourceMap": false,
            "extractLicenses": false,
            "styles": ["packages/web-components/src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules"]
            }
          }
        }
      }
    }
  }
}
