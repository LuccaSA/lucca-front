{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "dom", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "outDir": "../../dist/e2e-harness/esm",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["./src/**/*.ts"]
}
